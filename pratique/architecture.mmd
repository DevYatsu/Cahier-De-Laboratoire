%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 40, "rankSpacing": 55}} }%%
flowchart TB
    client(["Poste / client"])

    subgraph EDGE["réseau edge"]
        traefik["<b>Traefik</b><br/>TLS · forward-auth · rate limit<br/>access log JSON · /metrics<br/><b>C</b> · télémétrie désactivée<br/><i>:443 (seul port publié)</i>"]
        authelia["<b>Authelia</b><br/>fournisseur d'identité (SSO)"]
    end

    subgraph APPS["un réseau privé par backend (Traefik + l'application)"]
        juice["juice-shop<br/><i>HTTP interne</i>"]
        grafana["grafana<br/><i>auth proxy (Remote-User)</i><br/><b>C</b> · télémétrie désactivée"]
        cadv["cadvisor<br/><i>HTTP interne</i>"]
        alloyui["alloy (interface :12345)"]
    end

    subgraph MON["réseau monitoring"]
        prom["<b>prometheus</b><br/>règles d'alerte<br/><i>rétention 15 j / 5 Go</i>"]
        am["<b>alertmanager</b><br/>regroupe · déduplique · route"]
    end

    subgraph LOGS["réseau logs"]
        gate["<b>Traefik :3100</b><br/>loki-push : CA « ingest »<br/>loki-query : CA « reader »"]
        alloy["<b>alloy</b><br/><b>C</b> · ne collecte que les conteneurs du stack<br/><b>C</b> · masque données perso et secrets<br/><b>C</b> · télémétrie désactivée"]
    end

    subgraph LOKINET["réseau loki (Traefik seul)"]
        loki[("<b>loki</b><br/>compactor : rétention 30 j<br/>logs sécurité : 180 j<br/>ruler : règles LogQL<br/><b>C</b> · télémétrie désactivée")]
    end

    subgraph DAPI["réseau docker-api"]
        sproxy["socket-proxy<br/><i>GET uniquement</i>"]
        sock[["podman.sock"]]
    end

    subgraph EXT["hors du stack (autre système, autres comptes)"]
        worm[("<b>Copie WORM</b><br/>Object Lock, mode compliance<br/><i>rétention 1 an</i>")]
        hb["<b>heartbeat externe</b><br/>alerte si plus de signal"]
        oncall(["équipe d'astreinte<br/>mail / chat"])
    end

    client -- "HTTPS :443" --> traefik
    traefik -. "forward-auth" .-> authelia
    traefik -- "HTTP" --> juice
    traefik -- "HTTPS" --> grafana
    traefik -- "HTTP" --> cadv
    traefik -- "HTTPS" --> alloyui
    traefik -- "HTTPS" --> prom
    traefik -- "HTTPS (silences)" --> am

    alloy -- "mTLS, /push seulement" --> gate
    grafana -- "mTLS, /query* seulement" --> gate
    gate --> loki
    alloy -. "fan-out" .-> worm

    alloy -- "lecture des logs" --> sproxy
    cadv -- "lecture" --> sproxy
    traefik -- "découverte des labels" --> sproxy
    sproxy --> sock

    prom -- "scrape" --> traefik
    prom -- "scrape" --> grafana
    prom -- "scrape" --> cadv
    prom -- "scrape /metrics" --> gate
    prom -- "scrape" --> alloy

    prom -- "alertes" --> am
    loki -- "alertes du ruler" --> am
    am -- "notification" --> oncall
    am -. "Watchdog, chaque minute" .-> hb
    hb -- "silence = alerte" --> oncall

    subgraph LEG["légende"]
        l1["flèche = qui ouvre la connexion<br/>(scrape : les données reviennent vers Prometheus)<br/>pointillés = optionnel ou contrôle<br/><b>C</b> · = mesure de confidentialité"]
    end

    classDef gw fill:#1f6feb,color:#fff,stroke:#0b3d91
    classDef sec fill:#fff4e5,stroke:#d97706
    classDef alert fill:#fde8e8,stroke:#dc2626
    classDef keep fill:#e8f5e9,stroke:#16a34a
    classDef note fill:#ffffff,stroke:#9ca3af,color:#374151
    class traefik,gate gw
    class authelia,sproxy sec
    class am,hb,oncall alert
    class loki,worm keep
    class l1 note
    style LOKINET fill:#f0fdf4,stroke:#16a34a
